@startuml
title Agent Orchestrator Desktop - System Architecture

package "Renderer Process (React/TypeScript)" as Renderer {
    rectangle "React Shell" {
        component "ActivityBar" as AB
        component "Sidebar" as SB
        component "MainArea" as MA
        component "Panel" as PN
        component "ChatSidepanel" as CH
    }

    rectangle "State & IPC" {
        component "Zustand Stores" as ZS
        component "IPC Hooks" as IH
    }

    rectangle "Views" {
        component "OrgView" as OV
        component "DashboardView" as DV
        component "ConsoleView" as CV
        component "WorkflowView" as WV
        component "InspectorView" as IV
    }

    AB ---> SB
    SB ---> MA
    PN ---> MA
    CH ---> MA
    OV --> ZS
    DV --> ZS
    CV --> ZS
    WV --> ZS
    IV --> ZS
    ZS --> IH
}

package "Main Process (Node.js/TypeScript)" as Main {
    rectangle "IPC Handlers" {
        component "run-handlers" as RH
        component "workflow-handlers" as WH
        component "inspector-handlers" as IH
    }

    rectangle "Services" {
        component "ConfigReader" as CR
        component "EventBroker" as EB
        component "DashboardService" as DS
        component "InspectorService" as IS
        component "BackupService" as BS
        component "FileWatcher" as FW
    }

    rectangle "CLI Adapters" {
        component "EngineAdapter (interface)" as EA
        component "CodexEngine" as CE
        component "GeminiEngine" as GE
        component "OpenCodeEngine" as OC
        component "ClaudeCodeEngine" as CC
    }

    note right of OC
      Phase 5
    end note
    note right of CC
      Phase 5
    end note

    rectangle "Stores" {
        component "RunStore" as RS
        component "WorkflowStore" as WS
    }
}

package "Worker Threads" as WT {
    component "RunOrchestrator" as RO
    component "WorkflowEngine" as WE
}

Renderer --> Main : contextBridge (IPC)
Main --> IH : ipcMain.handle()
IH --> RH
IH --> WH
IH --> IS
RH --> RO
WH --> WE
RO --> EA
RO --> RS
WE --> WS
EA --> CE
EA --> GE
EA --> OC
EA --> CC
RO --> EB
WE --> EB
RH --> CR
RH --> DS
IS --> FW
IS --> BS

note top of Renderer
  Security: contextIsolation=true
  nodeIntegration=false
  sandbox=true
  NO direct fs/child_process
end note

note top of Main
  Trusted process
  ALLOWED_COMMANDS = ['codex', 'gemini']
  Shell injection prevention
  spawn() only, shell: false
end note

@enduml

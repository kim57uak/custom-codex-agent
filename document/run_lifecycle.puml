@startuml
title Run Lifecycle State Machine (Worker Thread)

state "Queued" as Queued
state "Running" as Running {
    state "Initializing" as Init
    state "ExecutingCLI" as Exec
    state "ProcessingOutput" as Proc
    [*] --> Init
    Init --> Exec : get_adapter()
    Exec --> Proc : CLI stdout/stderr stream
    Proc --> [*] : parse & store result
}

state "Completed" as Completed
state "Failed" as Failed
state "Canceled" as Canceled

[*] --> Queued : RunOrchestrator.queue()
Queued --> Running : _execute_run()\n(Worker Thread dispatch)
Running --> Completed : exit_code == 0
Running --> Failed : exit_code != 0\n|| AppError thrown
Running --> Canceled : cancel_run()\n(send SIGTERM to child)

Completed --> [*] : publish 'run:completed' via IPC
Failed --> [*] : publish 'run:failed' via IPC
Canceled --> [*] : publish 'run:canceled' via IPC

note top of Running
  Runs in Worker Thread
  Main Process receives
  progress via parentPort.on('message')
end note

@enduml

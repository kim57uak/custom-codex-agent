@startuml
title Prompt Processing & Execution Activity (Electron IPC)

start
:User inputs prompt in ConsoleView;
:ConsoleView validates input (length, type);

if (Engine selected?) then (yes)
  :Use selected Engine;
else (no)
  :Show EngineSelector dropdown;
  :Prompt user to select engine;
endif

partition "Renderer → Main (IPC)" {
  :window.electronAPI.runAgent({ engine, prompt, workspace });
  note: ipcRenderer.invoke('run:agent')
  :contextBridge passes to Main Process;
  :ipcMain.handle validates input\n(type check, length < 100KB, allowed command);
}

partition "Main → Worker Thread" {
  :RunOrchestrator receives validated input;
  :Create RunRecord (Status: Queued);
  :Dispatch to Worker Thread via parentPort;
}

partition "Worker Thread (CLI Execution)" {
  :Initialize Engine Adapter;
  :Resolve workspace root & skills;
  :Build full prompt context;
  :child_process.spawn(engine, args, { shell: false });
  :Stream stdout/stderr → parentPort.postMessage();
  :Parse CLI output;
}

partition "IPC Event Publishing" {
  :Worker Thread sends final result;
  :EventBroker routes to correct IPC channel;
  :Renderer receives via ipcRenderer.on();
  :Update Zustand Store;
  :ConsoleView shows terminal output + status;
}

stop
@enduml
